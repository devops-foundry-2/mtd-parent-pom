<?xml version="1.0" encoding="UTF-8"?>
<!--
  settings.xml — Maven settings template for mtd-parent-pom (GitHub Packages artifact store).
  Upload this file (base64-encoded) as the GitHub Actions secret MAVEN_SETTINGS_XML on every
  repo that builds against this parent POM. Fill every __FILL_ME__ placeholder before uploading.

  To base64-encode on macOS:  base64 -i settings.xml | pbcopy
  To base64-encode on Linux:  base64 -w 0 settings.xml | xclip

  SECURITY: Never commit a filled settings.xml. This template holds placeholders only.
  RULE: The server <id> values must match the <id> entries in the parent pom.xml exactly.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <servers>

    <!--
    GitHub Packages — publishes / resolves mtd-parent-pom and application artifacts.
    username : your GitHub username (or the bot/service account that owns the PAT).
    password : a GitHub PAT with read:packages (for resolving) OR write:packages (for publishing).
               In CI the pipeline uses GITHUB_TOKEN — no manual fill needed there.
               For local builds fill with a personal PAT scoped to read:packages.
    -->
    <server>
      <id>github</id>
      <username>__FILL_ME_GITHUB_USERNAME__</username>
      <password>__FILL_ME_GITHUB_PAT_READ_PACKAGES__</password>
    </server>

    <!--
    MuleSoft EE repository — required for the EE runtime artifacts (mule-maven-plugin, MUnit).
    Obtain credentials via a Salesforce / MuleSoft service request (EE licence required).
    username : your Anypoint Platform username (email).
    password : your Anypoint Platform password.
    -->
    <server>
      <id>mulesoft-ee-releases</id>
      <username>__FILL_ME_ANYPOINT_USERNAME__</username>
      <password>__FILL_ME_ANYPOINT_PASSWORD__</password>
    </server>

    <!--
    Anypoint Exchange v3 — resolves premium connectors (Salesforce, Anypoint MQ, etc.)
    and publishes applications to Exchange during the CloudHub 2.0 deploy flow.
    username : ~~~ (literal tilde × 3 — the Connected App client_id convention)
    password : the Connected App client_secret.
    Use the NONPROD Connected App for Design / Sandbox; the PROD app for Production.
    In CI these values are injected from GitHub environment secrets — no manual fill needed.
    For local builds fill with the NONPROD Connected App credentials.
    -->
    <server>
      <id>anypoint-exchange-v3</id>
      <username>~~~</username>
      <password>__FILL_ME_CONNECTED_APP_CLIENT_SECRET__</password>
    </server>

  </servers>

</settings>
